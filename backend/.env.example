# ------------------------------------------
# MySQL Database Configuration
# ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ai_finance
DB_CONNECTION_LIMIT=10
MYSQL_URL=mysql+aiomysql://your-db-user:your-db-password@localhost:3306/ai_finance

# ------------------------------------------
# Neo4j Configuration
# ------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_URL=bolt://localhost:7687

# ------------------------------------------
# Elasticsearch Configuration
# ------------------------------------------
ELASTIC_URL=http://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=your-elastic-password

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password

# ------------------------------------------
# MinIO Configuration
# ------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_FILE=ai-kg-file
MINIO_BUCKET_IMAGE=ai-kg-file
MINIO_SECURE=False

# ------------------------------------------
# Vector Model Configuration
# ------------------------------------------
VECTOR_MODEL_NAME=shibing624/text2vec-base-chinese
VECTOR_MODEL_CACHE_DIR=./models
VECTOR_DIMENSION=768

# ------------------------------------------
# LLM Model Configuration
# ------------------------------------------
LLM_API_URL=http://localhost:11434/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=Qwen2.5-14B-Instruct-1M
LLM_TEMPERATURE=0.3

# ------------------------------------------
# Vision Model Configuration
# ------------------------------------------
VISION_API_URL=http://localhost:11435/v1
VISION_API_KEY=your-vision-api-key
VISION_MODEL=Qwen2.5-VL-32B-Instruct

# ------------------------------------------
# General Settings
# ------------------------------------------
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# v12.2: Database Seed
# ------------------------------------------
# 启动时是否自动 seed（开发环境可开启；生产严禁开启）
SEED_ON_START=False
# True 时先清空所有表再 seed（重建）；False 时仅增量（已有数据保留）
SEED_FORCE_RELOAD=False
